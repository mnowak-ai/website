<style>
  :root{
    --purple:#7B2FBE;
    --purple-deep:#5A1E8F;
    --purple-tint:#F6EFFC;
    --purple-tint-2:#FBF8FE;
    --ink:#211B29;
    --slate:#6B6473;
    --line:#E9E3F0;
    --white:#FFFFFF;
    --maxread:960px;
    --maxwide:1360px;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth}
  body{
    font-family:"DM Sans",system-ui,sans-serif;color:var(--ink);background:var(--white);
    line-height:1.65;-webkit-font-smoothing:antialiased;font-size:19px;
  }
  h1,h2,h3,h4{font-family:"Fraunces",Georgia,serif;font-weight:500;line-height:1.12;letter-spacing:-0.01em}
  a{color:inherit}
  img{max-width:100%;display:block}
  .wrap{max-width:var(--maxwide);margin:0 auto;padding:0 24px}

  .eyebrow{font-size:.78rem;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--purple)}
  .hero-title{font-family:"Fraunces",Georgia,serif;font-weight:600;font-size:clamp(3rem,7vw,5.5rem);letter-spacing:-.02em;line-height:1;color:var(--purple);margin:0 auto 22px}

  .btn{
    display:inline-block !important;background:#7B2FBE !important;color:#fff !important;
    text-decoration:none !important;font-weight:700 !important;font-size:1.05rem !important;
    padding:15px 34px !important;border-radius:999px !important;border:none !important;
    box-shadow:none !important;outline:none !important;
    transition:background .2s ease,transform .2s ease;
    -webkit-appearance:none !important;appearance:none !important;
    font-family:"DM Sans",system-ui,sans-serif !important;
  }
  .btn:hover{background:#5A1E8F !important;transform:translateY(-1px);color:#fff !important;text-decoration:none !important}
  .btn:focus{outline:3px solid #7B2FBE !important;outline-offset:3px !important;box-shadow:none !important}
  .btn:visited{color:#fff !important}

  /* Hero */
  .hero{padding:96px 0 56px;text-align:center}
  .hero h1{font-size:clamp(2.8rem,6vw,4.6rem);margin:18px auto 22px;max-width:18ch}
  .hero p.lede{font-size:clamp(1.2rem,1.8vw,1.5rem);color:var(--slate);max-width:62ch;margin:0 auto;line-height:1.6}

  /* Stats */
  .stats{padding:8px 0 70px}
  .stats-grid{
    display:grid;grid-template-columns:repeat(3,1fr);gap:18px;
    border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:40px 0;
  }
  .stat{text-align:center}
  .stat .num{font-family:"Fraunces",serif;font-weight:600;font-size:clamp(2.8rem,5vw,3.8rem);color:var(--purple);line-height:1}
  .stat .lab{display:block;margin-top:10px;font-size:1.05rem;color:var(--slate);letter-spacing:.02em}
  .stat.badge .num{font-size:clamp(1.6rem,3vw,2.2rem);letter-spacing:-.01em}

  /* Cards */
  .stories-intro{text-align:center}
  .stories-intro h2{font-size:clamp(2.2rem,4vw,3rem)}
  .stories-intro p{color:var(--slate);margin-top:10px;max-width:52ch;margin-left:auto;margin-right:auto}

  .card-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:44px}
  .card{
    display:flex;flex-direction:column;align-items:center;text-align:center;
    text-decoration:none;color:inherit;border:1px solid var(--line);border-radius:20px;
    padding:34px 28px;background:#fff;
    transition:transform .2s ease,box-shadow .2s ease,border-color .2s ease;
  }
  .card:hover{transform:translateY(-4px);box-shadow:0 16px 38px rgba(33,27,41,.10);border-color:#D9C2F0}
  .card-logo{height:92px;display:flex;align-items:center;justify-content:center;margin-bottom:20px}
  .card-logo img{width:200px !important;height:84px !important;max-width:200px !important;max-height:84px !important;object-fit:contain !important;border-radius:8px}
  .card h3{font-size:1.5rem;margin-bottom:10px;letter-spacing:-.015em}
  .card .headline{color:var(--slate);font-size:1.12rem;line-height:1.55}
  .card .more{margin-top:22px;font-weight:700;font-size:1.05rem;color:var(--purple);display:inline-flex;align-items:center;gap:7px}
  .card .more svg{transition:transform .2s ease}
  .card:hover .more svg{transform:translateX(4px)}

  /* Quotes */
  .quotes{padding:96px 0 20px}
  .quotes-head{text-align:center;margin-bottom:18px}
  .quotes-head h2{font-size:clamp(1.8rem,3.4vw,2.5rem)}
  .quotes-head p{color:var(--slate);margin-top:10px}
  .qlist{max-width:760px;margin:0 auto}
  .qcard{padding:40px 0;border-top:1px solid var(--line);text-align:center}
  .qcard:first-child{border-top:none}
  .qcard p{font-family:"Fraunces",serif;font-style:italic;font-size:clamp(1.3rem,2.4vw,1.7rem);line-height:1.4;color:var(--ink)}
  .qcard .who{margin-top:18px;font-size:1.05rem;color:var(--slate)}
  .qcard .who b{color:var(--ink);font-weight:700}
  .qcard a.who-link{display:inline-block;margin-top:14px;font-weight:700;font-size:1rem;color:var(--purple);text-decoration:none}
  .qcard a.who-link:hover{text-decoration:underline}

  /* Coming soon section */
  .coming{padding:80px 0 20px;text-align:center}
  .coming-head{margin-bottom:48px}
  .coming-head .eyebrow{margin-bottom:14px;display:block;font-size:clamp(1.4rem,2.6vw,2rem);letter-spacing:.06em}
  .coming-head h2{font-size:clamp(1.9rem,3.6vw,2.8rem);max-width:22ch;margin:0 auto 16px}
  .coming-head p{color:var(--slate);max-width:58ch;margin:0 auto;font-size:1.15rem;line-height:1.65}
  .coming-grid{
    display:grid;grid-template-columns:repeat(3,1fr);gap:16px;
    max-width:var(--maxwide);margin:0 auto;
  }
  .coming-card{
    border:1px solid var(--line);border-radius:16px;padding:28px 22px;
    background:#fff;text-align:center;position:relative;overflow:hidden;
    transition:transform .2s ease,box-shadow .2s ease,border-color .2s ease;
  }
  .coming-card:hover{transform:translateY(-3px);box-shadow:0 12px 30px rgba(33,27,41,.08);border-color:#D9C2F0}
  .coming-card .logo-hold{
    height:72px;display:flex;align-items:center;justify-content:center;margin-bottom:16px;
  }
  .coming-card .logo-hold img{max-height:60px;max-width:160px;width:auto;object-fit:contain;border-radius:6px}
  .coming-card .logo-hold .logo-ph{
    width:60px;height:60px;border-radius:50%;
    background:var(--purple-tint);border:1.5px dashed #D9C2F0;
    display:grid;place-items:center;
    font-family:"Fraunces",serif;font-size:1.4rem;font-weight:600;color:var(--purple);
  }
  .coming-card h3{font-size:1.2rem;letter-spacing:-.01em;margin-bottom:8px}
  .coming-card .coming-badge{
    display:inline-block;font-size:.8rem;font-weight:700;letter-spacing:.12em;
    text-transform:uppercase;color:var(--purple);background:var(--purple-tint);
    padding:4px 10px;border-radius:999px;
  }
  .coming-pulse{
    display:inline-block;width:7px;height:7px;border-radius:50%;
    background:var(--purple);margin-right:6px;vertical-align:middle;
    animation:pulse 1.8s ease-in-out infinite;
  }
  @keyframes pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.45;transform:scale(.75)}}

  /* CTA */
  .cta{padding:90px 0 100px;text-align:center}
  .cta .inner{max-width:720px;margin:0 auto}
  .cta h2{font-size:clamp(2rem,4vw,3rem);margin-bottom:18px}
  .cta p{color:var(--slate);font-size:1.2rem;margin-bottom:30px}

  /* Motion */
  .reveal{opacity:0;transform:translateY(18px);transition:opacity .6s ease,transform .6s ease}
  .reveal.in{opacity:1;transform:none}

  @media (max-width:760px){
    body{font-size:16px}
    .hero{padding:64px 0 44px}
    .stats-grid{grid-template-columns:1fr;gap:30px}
    .card-grid{grid-template-columns:1fr}
    .coming-grid{grid-template-columns:1fr}
  }
  @media (prefers-reduced-motion:reduce){
    html{scroll-behavior:auto}
    .reveal{opacity:1;transform:none;transition:none}
    .card,.btn,.more svg{transition:none}
  }
  :focus-visible{outline:3px solid var(--purple);outline-offset:3px;border-radius:4px}
</style>
</head>
